NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/karnix_auth
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=karnix-auth-api
JWT_AUDIENCE=karnix-web
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12
ACCESS_TOKEN_TTL=15m
ACCESS_TOKEN_MAX_AGE_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT=10
BODY_LIMIT_BYTES=16384
TRUST_PROXY=false
COOKIE_SECURE=false
PREDICTION_EXECUTABLE=/absolute/path/to/Other_Disease/build/lung_xray_ml
PREDICTION_MODEL_PATH=/absolute/path/to/Other_Disease/models/lung_xray.weights
PREDICTION_INPUT_ROOT=/absolute/path/to/server-local/prediction-inputs
OSTEOARTHRITIS_EXECUTABLE=/absolute/path/to/Other_Disease/build/osteoarthritis_ml
OSTEOARTHRITIS_MODEL_PATH=/absolute/path/to/karnix_spine_edge/models/osteoarthritis_cnn.baseline.weights
BRAIN_TUMOR_EXECUTABLE=/absolute/path/to/Other_Disease/build/brain_tumor_ml
BRAIN_TUMOR_MODEL_PATH=/absolute/path/to/Brain_tumour/models/brain_tumour_cnn.weights
LUMBAR_STENOSIS_EXECUTABLE=/absolute/path/to/Other_Disease/build/lumbar_stenosis_ml
LUMBAR_STENOSIS_MODEL_PATH=/absolute/path/to/karnix_spine_edge/models/spine_model.weights
DEMO_LUNG_IMAGE=/absolute/path/to/Other_Disease/smoke_dataset/sick/sick.pgm
DEMO_BRAIN_TUMOR_IMAGE=/absolute/path/to/Brain_tumour/data/brain_tumor/Testing/pituitary_tumor/pituitary_tumor_0023.jpg
DEMO_OSTEOARTHRITIS_IMAGE=/absolute/path/to/karnix_spine_edge/data/images/test_normal_01.ppm
DEMO_LUMBAR_STENOSIS_IMAGE=/absolute/path/to/karnix_spine_edge/data/mri/test/no_stenosis/no_stenosis_0000_no_stenosis.pgm
